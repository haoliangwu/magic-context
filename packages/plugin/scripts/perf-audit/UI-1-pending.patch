+fn model_catalog_audit(root: &Path) {
+    use std::os::unix::fs::PermissionsExt;
+    let bin = root.join("catalog-bin");
+    std::fs::create_dir_all(&bin).unwrap();
+    let trace = root.join("catalog.trace");
+    let shell_quote = |s: &str| format!("'{}'", s.replace('\'', "'\\''"));
+    for name in ["opencode", "pi", "omp"] {
+        let models = if name == "opencode" {
+            (0..500)
+                .map(|i| format!("anthropic/model-{i}\n"))
+                .collect::<String>()
+        } else {
+            format!(
+                "provider model context max-output reasoning images\n{}",
+                (0..500)
+                    .map(|i| format!("anthropic model-{i} 200k 64k yes yes\n"))
+                    .collect::<String>()
+            )
+        };
+        let path = bin.join(name);
+        std::fs::write(
+            &path,
+            format!(
+                "#!/bin/sh\nprintf '%s\\n' '{name}' >> {}\ncat <<'MODELS'\n{models}MODELS\n",
+                shell_quote(trace.to_str().unwrap())
+            ),
+        )
+        .unwrap();
+        std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o755)).unwrap();
+    }
+    let mut env = crate::test_env::EnvGuard::new();
+    env.set(
+        "PATH",
+        format!(
+            "{}:{}",
+            bin.display(),
+            std::env::var("PATH").unwrap_or_default()
+        ),
+    );
+    env.set(
+        "PI_PACKAGE_DIR",
+        root.join("empty-pi-package").to_str().unwrap(),
+    );
+    env.set("PI_CONFIG_DIR", root.join("pi-config").to_str().unwrap());
+    let runtime = tokio::runtime::Runtime::new().unwrap();
+    for pass in ["App", "Dreamer"] {
+        let catalogs = timed(
+            &format!("UI-11 {pass} model catalog / local mock CLIs"),
+            || runtime.block_on(crate::commands::get_model_catalogs()),
+        );
+        assert!(
+            !catalogs.opencode.is_empty(),
+            "catalog probe did not reach mock output"
+        );
+        println!(
+            "UI-11 catalogs opencode={} pi={} omp={}",
+            catalogs.opencode.len(),
+            catalogs.pi.len(),
+            catalogs.omp.len()
+        );
+    }
+    let probes = std::fs::read_to_string(trace).unwrap().lines().count();
+    println!("UI-11 CLI invocations across App and Dreamer: {probes}");
+}
