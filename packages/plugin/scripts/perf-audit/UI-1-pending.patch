+fn jsonl_append_audit(root: &Path) {
+    for count in [1_000, 10_000, 60_000] {
+        let pi_path = root.join(format!("pi-{count}.jsonl"));
+        let claude_path = root.join(format!("claude-{count}.jsonl"));
+        let pi_line = |i: usize| {
+            format!("{{\"type\":\"message\",\"id\":\"m{i}\",\"timestamp\":1700000000000,\"message\":{{\"role\":\"assistant\",\"content\":[{{\"type\":\"text\",\"text\":\"hello\"}}],\"usage\":{{\"input\":100,\"output\":1,\"totalTokens\":101}}}}}}\n")
+        };
+        let claude_line = |i: usize| {
+            format!("{{\"type\":\"assistant\",\"uuid\":\"m{i}\",\"sessionId\":\"audit\",\"cwd\":\"/audit\",\"timestamp\":\"2026-01-01T00:00:00Z\",\"message\":{{\"model\":\"test\",\"usage\":{{\"input_tokens\":100,\"output_tokens\":1}}}}}}\n")
+        };
+        let mut pi = std::fs::File::create(&pi_path).unwrap();
+        writeln!(
+            pi,
+            "{{\"type\":\"session\",\"id\":\"audit\",\"cwd\":\"/audit\"}}"
+        )
+        .unwrap();
+        let mut claude = std::fs::File::create(&claude_path).unwrap();
+        for i in 0..count {
+            pi.write_all(pi_line(i).as_bytes()).unwrap();
+            claude.write_all(claude_line(i).as_bytes()).unwrap();
+        }
+        drop(pi);
+        drop(claude);
+        timed(&format!("UI-6 Pi cold {count}"), || {
+            pi_sessions::read_pi_session_detail(&pi_path).unwrap()
+        });
+        timed(&format!("UI-6 Claude cold {count}"), || {
+            external_cache_sessions::read_claude_code_session_detail(&claude_path).unwrap()
+        });
+        std::fs::OpenOptions::new()
+            .append(true)
+            .open(&pi_path)
+            .unwrap()
+            .write_all(pi_line(count).as_bytes())
+            .unwrap();
+        std::fs::OpenOptions::new()
+            .append(true)
+            .open(&claude_path)
+            .unwrap()
+            .write_all(claude_line(count).as_bytes())
+            .unwrap();
+        let pi = timed(&format!("UI-6 Pi append {count}"), || {
+            pi_sessions::read_pi_session_detail(&pi_path).unwrap()
+        });
+        if count == 60_000 {
+            let legacy = timed("UI-1 Pi legacy DTO clone / 60k", || {
+                pi.messages
+                    .iter()
+                    .map(|m| LegacyMessage {
+                        message_id: m.entry_id.clone(),
+                        timestamp_ms: m.timestamp_ms,
+                        role: m.role.clone(),
+                        text_preview: m.text_preview.clone(),
+                        raw_json: m.raw_json.clone(),
+                    })
+                    .collect::<Vec<_>>()
+            });
+            let compact = timed("UI-1 Pi compact DTO clone / 60k", || {
+                pi.messages
+                    .iter()
+                    .map(|m| SessionMessageRow {
+                        message_id: m.entry_id.clone(),
+                        timestamp_ms: m.timestamp_ms,
+                        role: m.role.clone(),
+                        text_preview: m.text_preview.clone(),
+                    })
+                    .collect::<Vec<_>>()
+            });
+            let legacy_wire = timed("UI-1 Pi legacy serde serialize / 60k", || {
+                serde_json::to_vec(&legacy).unwrap()
+            });
+            let compact_wire = timed("UI-1 Pi compact serde serialize / 60k", || {
+                serde_json::to_vec(&compact).unwrap()
+            });
+            let mut visible = serde_json::to_value(&legacy).unwrap();
+            for row in visible.as_array_mut().unwrap() {
+                row.as_object_mut().unwrap().remove("raw_json");
+            }
+            assert_eq!(visible, serde_json::to_value(&compact).unwrap());
+            println!(
+                "UI-1 Pi rows={} IPC={} -> {}",
+                compact.len(),
+                legacy_wire.len(),
+                compact_wire.len()
+            );
+        }
+        let claude = timed(&format!("UI-6 Claude append {count}"), || {
+            external_cache_sessions::read_claude_code_session_detail(&claude_path).unwrap()
+        });
+        assert_eq!(pi.messages.len(), count + 1);
+        assert_eq!(claude.events.len(), count + 1);
+        std::fs::remove_file(pi_path).unwrap();
+        std::fs::remove_file(claude_path).unwrap();
+    }
+}
