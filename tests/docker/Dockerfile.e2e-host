# Magic Context — full host-behavior E2E image
#
# The repository is deliberately not copied into this image. The release runner
# bind-mounts the checkout read-only and stages it into a tmpfs before installing
# dependencies, so a test can never write into the checkout or the user's home.
# No --platform flag is used: Docker builds and runs this image for its native
# architecture (including linux/arm64 on Apple silicon).

FROM oven/bun:1.3.14-debian

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    python3 \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# The host behavior suite launches the real OpenCode server and Pi process. Keep
# both runtimes in the image instead of relying on anything installed on the
# machine running the release gate.
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version \
    && bun --version

COPY install-opencode.sh /usr/local/bin/install-opencode.sh
RUN install-opencode.sh \
    && install -m 0755 /root/.opencode/bin/opencode /usr/local/bin/opencode

# Pi's package is installed globally so the e2e runner can resolve the same CLI
# entry point that a normal user installation provides. Its per-user settings
# and caches are redirected to the container tmpfs by release-e2e-docker.sh.
RUN npm install --global --no-audit --no-fund @earendil-works/pi-coding-agent@latest \
    && command -v pi \
    && pi --version

WORKDIR /workspace
CMD ["bash"]
