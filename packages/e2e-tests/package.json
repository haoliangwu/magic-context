{
  "name": "@cortexkit/opencode-magic-context-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun ../../scripts/check-bun.mjs && bun test --timeout 120000",
    "ensure-shared-opencode2": "bun scripts/ensure-shared-opencode2.ts",
    "test:opencode2": "bun scripts/ensure-shared-opencode2.ts && bun test --timeout 120000",
    "test:validate-manifest": "bun test scripts/validate-mode-manifest.test.ts scripts/check-rust-prerequisites.test.ts",
    "validate-mode-manifest": "bun scripts/validate-mode-manifest.ts --mode ts",
    "adjudicate:thinking-block": "bash scripts/adjudicate-thinking-block.sh",
    "test:rust-e2e": "bun test --timeout 600000 --max-concurrency=1 tests/rust-*.test.ts",
    "mutation:rust-historian": "bun scripts/run-rust-historian-producer-mutation.ts",
    "mutation:rust-ctx-reduce": "bun scripts/run-rust-ctx-reduce-mutation.ts",
    "mutation:paired-replay": "bun scripts/run-paired-replay-mutation.ts",
    "measure:mid-turn-ab": "bun scripts/run-mid-turn-prefix-ab.ts",
    "measure:native-memory": "bun scripts/capture-heap-long-session.ts",
    "replay:transform-wire-parity": "bun scripts/replay-transform-wire-parity.ts"
  },
  "dependencies": {
    "@cortexkit/subc-client": "0.11.1",
    "@opencode-ai/sdk": "^1.15.13"
  },
  "devDependencies": {
    "@cortexkit/claustrum-client": "0.5.0",
    "@oh-my-pi/pi-coding-agent": "^18.2.6",
    "@opencode/ai": "2.0.22",
    "@opencode/client": "2.0.22",
    "@types/bun": "latest",
    "bun-types": "^1.3.11",
    "typescript": "^5.6.0"
  }
}
