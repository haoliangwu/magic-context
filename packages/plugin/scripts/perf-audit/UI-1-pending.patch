+#[test]
+#[ignore = "requires isolated real-store copies; run with --ignored --nocapture"]
+fn native_dashboard_audit() {
+    let root = PathBuf::from(std::env::var("PERF_UI_ROOT").expect("isolated root required"));
+    assert!(
+        root.join("paths-isolated").is_file(),
+        "reroot recorded directory pointers before native discovery"
+    );
+    for key in [
+        "HOME",
+        "XDG_DATA_HOME",
+        "XDG_CONFIG_HOME",
+        "PI_CODING_AGENT_DIR",
+        "BROCA_STATE_ROOT",
+    ] {
+        assert!(
+            PathBuf::from(std::env::var(key).expect(key)).starts_with(&root),
+            "{key} not isolated"
+        );
+    }
+    let session = std::env::var("PERF_UI_SESSION").expect("large session required");
+    let host_path = resolve_opencode_db_path().unwrap();
+    let context_path = resolve_db_path().unwrap();
+    assert!(host_path.starts_with(&root) && context_path.starts_with(&root));
+    let host = open_readonly(&host_path).unwrap();
+    let context = open_readonly(&context_path).unwrap();
+    let generation = resolve_opencode_sessions(&host).unwrap().owner(&session).unwrap();
+    println!("session generation: {generation:?}");
+    let handles = std::process::Command::new("lsof")
+        .args(["-p", &std::process::id().to_string()])
+        .output()
+        .unwrap();
+    let handles = String::from_utf8(handles.stdout).unwrap();
+    let db_handles: Vec<_> = handles
+        .lines()
+        .filter(|line| line.contains(".db"))
+        .collect();
+    assert!(!db_handles.is_empty());
+    assert!(db_handles
+        .iter()
+        .all(|line| line.contains(root.to_str().unwrap())));
+    println!("lsof: {} isolated DB handles", db_handles.len());
+    for pass in ["cold", "warm"] {
+        println!("=== {pass} ===");
+        let before = timed("UI-1 legacy message query", || {
+            legacy_messages(&host, generation, &session)
+        });
+        let before_wire = timed("UI-1 legacy serde serialize", || {
+            serde_json::to_vec(&before).unwrap()
+        });
+        let after = timed("UI-1 current message query", || {
+            load_opencode_messages(&host, generation, &session).unwrap()
+        });
+        let after_wire = timed("UI-1 current serde serialize", || {
+            serde_json::to_vec(&after).unwrap()
+        });
+        let mut display_before = serde_json::to_value(&before).unwrap();
+        for row in display_before.as_array_mut().unwrap() {
+            row.as_object_mut().unwrap().remove("raw_json");
+        }
+        let display_after = serde_json::to_value(&after).unwrap();
+        assert_eq!(display_before, display_after, "displayed messages changed");
+        let display_wire = serde_json::to_vec(&display_after).unwrap();
+        println!(
+            "UI-1 rows={} IPC={} -> {} display_sha256={:x}",
+            after.len(),
+            before_wire.len(),
+            after_wire.len(),
+            Sha256::digest(&display_wire)
+        );
+        if pass == "warm" {
+            std::fs::write(root.join("native-before-ipc.json"), before_wire).unwrap();
+            std::fs::write(root.join("native-after-ipc.json"), after_wire).unwrap();
+        }
+        let detail = timed("UI-2/UI-8 session detail", || {
+            get_session_detail(Some(&context), Harness::Opencode, &session)
+                .unwrap()
+                .unwrap()
+        });
+        if pass == "warm" {
+            std::fs::write(
+                root.join("native-detail.json"),
+                serde_json::to_vec(&detail).unwrap(),
+            )
+            .unwrap();
+        }
+        let index: HashMap<_, _> = after
+            .iter()
+            .enumerate()
+            .map(|(i, m)| (m.message_id.as_str(), i))
+            .collect();
+        let last_boundary = detail
+            .compartments
+            .iter()
+            .filter_map(|c| c.end_message_id.as_deref().and_then(|id| index.get(id)))
+            .max()
+            .copied();
+        let visible_tail = after
+            .iter()
+            .skip(last_boundary.map_or(0, |i| i + 1))
+            .filter(|m| m.role != "assistant" || !m.text_preview.trim().is_empty())
+            .count();
+        println!(
+            "UI-2 compartments={} visible_live_tail={visible_tail}",
+            detail.compartments.len()
+        );
+        timed("UI-7 full session ownership index", || {
+            resolve_opencode_sessions(&host).unwrap()
+        });
+        timed("UI-7 point ID lower bound", || {
+            host.query_row(
+                "SELECT EXISTS(SELECT 1 FROM session WHERE id=?1)",
+                [&session],
+                |r| r.get::<_, bool>(0),
+            )
+            .unwrap()
+        });
+        timed("UI-8 badge count", || {
+            host.query_row("SELECT COUNT(*) FROM message WHERE session_id=?1 AND json_extract(data,'$.role')='assistant' AND COALESCE(CAST(json_extract(data,'$.tokens.total') AS INTEGER),0)>0", [&session], |r| r.get::<_, i64>(0)).unwrap()
+        });
+        let cards = timed("UI-3 project cards", || get_project_cards(&context));
+        println!("UI-3 cards={}", cards.len());
+        timed("UI-4 get_projects", || get_projects(&context).unwrap());
+        timed("UI-4 get_dreamer_projects", || {
+            get_dreamer_projects(&context).unwrap()
+        });
+        let stats = timed("UI-5 reconcile stats poll", || {
+            get_session_cache_stats_from_db(50, false, true, None)
+        });
+        println!(
+            "UI-5 stats={} IPC={}",
+            stats.len(),
+            serde_json::to_vec(&stats).unwrap().len()
+        );
+        let windows = timed("UI-5 top 10 window loads", || {
+            stats
+                .iter()
+                .take(10)
+                .map(|s| get_session_cache_events(s.harness, &s.session_id, Some(60), None))
+                .collect::<Vec<_>>()
+        });
+        assert!(
+            !stats.is_empty(),
+            "cache poll fixture did not reach any sessions"
+        );
+        if pass == "warm" {
+            std::fs::write(
+                root.join("native-cache-stats.json"),
+                serde_json::to_vec(&stats).unwrap(),
+            )
+            .unwrap();
+            std::fs::write(
+                root.join("native-cache-windows.json"),
+                serde_json::to_vec(&windows).unwrap(),
+            )
+            .unwrap();
+        }
+        timed("UI-5 incremental poll", || {
+            stats
+                .iter()
+                .zip(windows.iter())
+                .map(|(s, events)| {
+                    get_session_cache_events(
+                        s.harness,
+                        &s.session_id,
+                        None,
+                        events.last().map(|e| e.timestamp),
+                    )
+                })
+                .collect::<Vec<_>>()
+        });
+        let paged = timed("UI-9 first session page", || {
+            list_sessions_paged(SessionFilter {
+                limit: Some(50),
+                ..Default::default()
+            })
+        });
+        println!("UI-9 rows={} total={}", paged.rows.len(), paged.total);
+        let memory_stats = timed("UI-13 all memory stats", || {
+            get_memory_stats(&context, None, None).unwrap()
+        });
+        println!("UI-13 memories={}", memory_stats.total);
+    }
+    workspace_and_log_audit(&context, &root);
+    model_catalog_audit(&root);
+    broca_list_audit();
+    jsonl_append_audit(&root);
+}
+
+fn workspace_and_log_audit(context: &Connection, root: &Path) {
+    let mut memories = get_memories(context, None, None, None, None, None, 200, 0).unwrap();
+    assert_eq!(memories.len(), 200, "memory-page fixture too small");
+    let workspace = Connection::open_in_memory().unwrap();
+    workspace.execute_batch("CREATE TABLE schema_migrations(version INTEGER); INSERT INTO schema_migrations VALUES (94);
+        CREATE TABLE workspaces(id INTEGER, name TEXT, share_categories TEXT);
+        CREATE TABLE workspace_members(workspace_id INTEGER, project_path TEXT, display_name TEXT);
+        INSERT INTO workspaces VALUES (1, 'audit', '[]');").unwrap();
+    for i in 0..16 {
+        workspace
+            .execute(
+                "INSERT INTO workspace_members VALUES (1, ?1, ?2)",
+                rusqlite::params![format!("git:project{i}"), format!("Project {i}")],
+            )
+            .unwrap();
+    }
+    for (i, memory) in memories.iter_mut().enumerate() {
+        memory.project_path = format!("git:project{}", i % 16);
+    }
+    timed("UI-14 enrich 200 memories / 16 workspace members", || {
+        enrich_memories_workspace_source(&workspace, Some(1), &mut memories).unwrap()
+    });
+    assert!(memories.iter().all(|m| m.source_display_name.is_some()));
+    for count in [1_000, 10_000, 60_000] {
+        let path = root.join(format!("logs-{count}.log"));
+        let mut file = std::fs::File::create(&path).unwrap();
+        for i in 0..count {
+            writeln!(file, "2026-01-01T00:00:00.000Z INFO  magic-context.perf: [session=opencode:audit] transform pass={i} duration=42").unwrap();
+        }
+        drop(file);
+        let entries = timed(
+            &format!("UI-15 native log tail {count} / 500 visible rows"),
+            || crate::log_parser::read_log_tail(&path, 500),
+        );
+        assert_eq!(entries.len(), 500);
+        if count == 60_000 {
+            std::fs::write(
+                root.join("native-log-entries.json"),
+                serde_json::to_vec(&entries).unwrap(),
+            )
+            .unwrap();
+        }
+        std::fs::remove_file(path).unwrap();
+    }
+}
