+//! Native read-only audit. Set PERF_UI_ROOT to an isolated root containing
+//! scrubbed VACUUM INTO copies, PERF_UI_SESSION to a large real session, and
+//! HOME/XDG_DATA_HOME/XDG_CONFIG_HOME/PI_CODING_AGENT_DIR/BROCA_STATE_ROOT to
+//! directories underneath that root. Never run this against a live store.
+use super::*;
+use sha2::{Digest, Sha256};
+use std::io::Write;
+use std::time::Instant;
+
+fn timed<T>(label: &str, run: impl FnOnce() -> T) -> T {
+    let start = Instant::now();
+    let result = run();
+    println!("{label}: {:.3} ms", start.elapsed().as_secs_f64() * 1000.0);
+    result
+}
+
+// Frozen pre-optimization message query and DTO. Keeping the original parse
+// and serialization path here lets one binary compare both on the same store.
+#[derive(Serialize)]
+struct LegacyMessage {
+    message_id: String,
+    timestamp_ms: i64,
+    role: String,
+    text_preview: String,
+    raw_json: serde_json::Value,
+}
+
+fn legacy_messages(conn: &Connection, generation: OpenCodeStoreGeneration, session: &str) -> Vec<LegacyMessage> {
+    let sql = match generation {
+        OpenCodeStoreGeneration::V1 => "SELECT CAST(m.id AS TEXT), m.time_created,
+        COALESCE(CAST(json_extract(m.data, '$.role') AS TEXT), ''), m.data,
+        COALESCE((SELECT GROUP_CONCAT(json_extract(p.data, '$.text'), ' ')
+            FROM part p WHERE p.message_id=m.id
+            AND json_extract(p.data, '$.type')='text'
+            AND json_extract(p.data, '$.text') IS NOT NULL), '')
+        FROM message m WHERE m.session_id=?1 ORDER BY m.time_created ASC",
+        OpenCodeStoreGeneration::V2 => "SELECT CAST(m.id AS TEXT), m.time_created,
+            CASE WHEN m.type='assistant' THEN 'assistant' ELSE 'user' END, m.data, ''
+            FROM session_message m WHERE m.session_id=?1
+            AND m.type NOT IN ('idle','agent-switched','model-switched','location-switched')
+            ORDER BY m.seq ASC",
+    };
+    let mut stmt = conn
+        .prepare(sql)
+        .unwrap();
+    let rows = stmt
+        .query_map([session], |row| {
+            let raw_string: String = row.get(3)?;
+            let raw_json: serde_json::Value = serde_json::from_str(&raw_string).unwrap_or_default();
+            let aggregated_text: String = row.get(4)?;
+            let text_preview = if aggregated_text.is_empty() {
+                preview_from_json(&raw_json)
+            } else {
+                normalize_preview(&aggregated_text)
+            };
+            Ok(LegacyMessage {
+                message_id: row.get(0)?,
+                timestamp_ms: row.get(1)?,
+                role: row.get(2)?,
+                text_preview,
+                raw_json,
+            })
+        })
+        .unwrap()
+        .collect::<Result<Vec<_>, _>>()
+        .unwrap();
+    rows
+}
