+fn broca_list_audit() {
+    for count in [1_000, 10_000, 60_000] {
+        let conn = Connection::open_in_memory().unwrap();
+        conn.execute_batch("CREATE TABLE export_facts(segment_json TEXT); BEGIN;")
+            .unwrap();
+        {
+            let mut insert = conn
+                .prepare("INSERT INTO export_facts VALUES (?1)")
+                .unwrap();
+            for i in 0..count {
+                insert.execute([format!("{{\"session\":{{\"session\":\"s{}\",\"harness\":\"broca\"}},\"occurred_at_ms\":{i}}}", i % 200)]).unwrap();
+            }
+        }
+        conn.execute_batch("COMMIT;").unwrap();
+        let sessions = timed(
+            &format!("UI-5 Broca list {count} facts / 200 sessions"),
+            || load_broca_cache_sessions_from_conn(&conn, None, 50).unwrap(),
+        );
+        assert_eq!(sessions.len(), 50);
+    }
+}
