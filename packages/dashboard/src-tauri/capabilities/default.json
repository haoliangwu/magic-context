{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "updater:default",
    "dialog:default",
    "process:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://docs.cortexkit.io/magic-context/*" }]
    }
  ]
}
