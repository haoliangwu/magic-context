{
  "name": "@cortexkit/dsh-magic-context",
  "version": "0.2.0",
  "type": "module",
  "description": "Magic Context — DeepSeek Harness adapter (Host / Agent / Client + profile bundle). Loads the shared Magic SQLite store and registers ctx_* tools, /ctx-* commands, knowledge injection, historian/dreamer scheduling, compaction policy, and the Typert Remote surface for the DSH client.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dsh-magic-context": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./agent": "./dist/entries/agent.js",
    "./compaction": "./dist/entries/compaction.js",
    "./commands": "./dist/entries/commands.js",
    "./tools": "./dist/entries/tools.js",
    "./remote": "./dist/entries/remote.js",
    "./preset-include": "./dist/entries/preset-include.js",
    "./client": "./src/client/client.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "cordis.patch.yml",
    "NOTICE"
  ],
  "scripts": {
    "build": "bash scripts/build.sh",
    "prepare": "bun run build 2>&1 | head -n 20; test -f dist/index.js || (echo '[dsh-magic-context] prepare: dist missing — run bun run build manually' >&2; exit 0)",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ai-tokenizer": "^1.0.6",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.1.1-rc.2",
    "@types/bun": "^1.3.10",
    "@types/node": "^22.20.0",
    "esbuild": "^0.28.2",
    "js-yaml": "^4.1.0",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
